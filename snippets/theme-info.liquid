{% assign current_domain = shop.domain %}

<script>
 async function checkLicense(licenseKey, domain) {
  try {
    const response = await fetch("https://licensecheck.dungmaster3.workers.dev/", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ licenseKey, domain })
    });

    if (!response.ok) {
      throw new Error(`HTTP error! status: ${response.status}`);
    }

    const result = await response.json();
    if (!result.valid) {
      document.body.innerHTML = `
        <div style="text-align: center; padding: 50px;">
          <h1>License Invalid</h1>
          <p>This theme is not licensed for use on this domain.</p>
        </div>
      `;
    }
  } 
  // catch (error) {
  //   console.error("Error checking license:", error);
  //   document.body.innerHTML = `
  //     <div style="text-align: center; padding: 50px;">
  //       <h1>Error</h1>
  //       <p>Unable to verify the license. Please try again later.</p>
  //     </div>
  //   `;
  // }
}


checkLicense("{{ settings.theme_license }}", "{{ current_domain }}");

</script>
